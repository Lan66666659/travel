<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kmbeast.mapper.ScenicSpotMapper">

    <resultMap id="entityMap" type="com.kmbeast.pojo.vo.ScenicSpotListVO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="cover" property="cover"/>
        <result column="summary" property="summary"/>
        <result column="province_name" property="provinceName"/>
        <result column="city_name" property="cityName"/>
    </resultMap>

    <resultMap id="entityVOMap" type="com.kmbeast.pojo.vo.ScenicSpotVO">

        <!--景点基本信息-->
        <id column="id" property="id"/>
        <result column="region_id" property="regionId"/>
        <result column="title" property="title"/>
        <result column="cover" property="cover"/>
        <result column="content" property="content"/>
        <result column="summary" property="summary"/>
        <result column="create_time" property="createTime"/>

        <!--地区信息-->
        <result column="parent_region_id" property="parentRegionId"/>
        <result column="province_name" property="provinceName"/>
        <result column="city_name" property="cityName"/>

        <result column="view_count" property="viewCount"/>
        <result column="upvote_count" property="upvoteCount"/>
        <result column="collection_count" property="collectionCount"/>


        <!--景点对于图册：一对多-->
        <collection property="brochureList" ofType="com.kmbeast.pojo.entity.ScenicSpotBrochure">
            <id column="brochure_id" property="id"/>
            <result column="scenic_spot_id" property="scenicSpotId"/>
            <result column="cover_url" property="coverUrl"/>
            <result column="order_number" property="orderNumber"/>
        </collection>


        <!--景点关联的景点种类： 一对多-->
        <!--        <collection property="scenicSpotCategoryList" ofType="com.kmbeast.pojo.entity.ScenicSpotCategory">-->
        <!--            <id column="scenic_spot_category_id" property="id"/>-->
        <!--            <result column="scenic_spot_id" property="scenicSpotId"/>-->
        <!--            <result column="category_id" property="categoryId"/>-->
        <!--        </collection>-->

    </resultMap>

    <select id="listPage" resultMap="entityMap">

        SELECT ss.id,
        ss.title,
        ss.cover,
        ss.summary,
        r2.name AS province_name,
        r1.name AS city_name
        FROM scenic_spot ss
        LEFT JOIN region r1 ON r1.id = ss.region_id
        LEFT JOIN region r2 ON r2.id = r1.parent_id
        <where>
            <if test="title != null and title != ''">
                AND ss.title LIKE concat('%',#{title},'%')
            </if>
            <if test="regionIds != null and regionIds.size()>0">
                AND ss.region_id IN
                <foreach collection="regionIds" item="regionId" separator="," open="(" close=")" index="index">
                    #{regionId}
                </foreach>
            </if>
            <if test="startTime != null and endTime != null">
                AND ss.create_time BETWEEN #{startTime} AND #{endTime}
            </if>
            <if test="ids != null and ids.size()>0">
                AND ss.id IN
                <foreach collection="ids" item="id" index="index" separator="," open="(" close=")">
                    #{id}
                </foreach>
            </if>
        </where>
        ORDER BY ss.id DESC
        <if test="current != null and size != null">
            LIMIT #{current},#{size}
        </if>

    </select>

    <select id="listPageCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM scenic_spot ss
        <where>
            <if test="title != null and title != ''">
                AND ss.title LIKE concat('%',#{title},'%')
            </if>
            <if test="regionIds != null and regionIds.size()>0">
                AND ss.region_id IN
                <foreach collection="regionIds" item="regionId" separator="," open="(" close=")" index="index">
                    #{regionId}
                </foreach>
            </if>
            <if test="startTime != null and endTime != null">
                AND ss.create_time BETWEEN #{startTime} AND #{endTime}
            </if>
            <if test="ids != null and ids.size()>0">
                AND ss.id IN
                <foreach collection="ids" item="id" index="index" separator="," open="(" close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <select id="getDetailById" resultMap="entityVOMap">
        SELECT ss.id,
               ss.region_id,
               ss.title,
               ss.cover,
               ss.content,
               ss.summary,
               ss.create_time,
               r2.id                           AS parent_region_id,
               r2.name                         AS province_name,
               r1.name                         AS city_name,
               ssb.id                          AS brochure_id,
               ssb.scenic_spot_id,
               ssb.cover_url,
               ssb.order_number,
               (SELECT COUNT(uao1.id)
                FROM user_action_operation uao1
                WHERE uao1.type = 3
                  AND uao1.content_module = 'SCENIC_SPOT'
                  AND uao1.content_id = ss.id) AS view_count,
               (SELECT COUNT(uao2.id)
                FROM user_action_operation uao2
                WHERE uao2.type = 2
                  AND uao2.content_module = 'SCENIC_SPOT'
                  AND uao2.content_id = ss.id) AS upvote_count,
               (SELECT COUNT(uao3.id)
                FROM user_action_operation uao3
                WHERE uao3.type = 1
                  AND uao3.content_module = 'SCENIC_SPOT'
                  AND uao3.content_id = ss.id) AS collection_count
        #                ssc.id AS scenic_spot_category_id,
#                ssc.scenic_spot_id,
#                ssc.category_id
        FROM scenic_spot ss
                 LEFT JOIN region r1 ON r1.id = ss.region_id
                 LEFT JOIN region r2 ON r2.id = r1.parent_id
#                  LEFT JOIN scenic_spot_category ssc ON ssc.scenic_spot_id = ss.id
                 LEFT JOIN scenic_spot_brochure ssb ON ssb.scenic_spot_id = ss.id
        WHERE ss.id = #{id}
    </select>

</mapper>